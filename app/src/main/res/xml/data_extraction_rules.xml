<?xml version="1.0" encoding="utf-8"?>
<!-- Business data and the device-bound activation never leave the device through automatic cloud backup / device transfer.
     Moving to a new phone is an intentional Backup -> Restore + license reactivation (see docs). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
